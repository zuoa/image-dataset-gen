# Generate secrets before production use, for example: `openssl rand -hex 32`.
SECRET_KEY=replace-with-at-least-32-random-characters
JWT_SECRET_KEY=replace-with-another-32-random-characters
# Generate with: `openssl rand -base64 32`
ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key
TRAINING_WORKER_TOKEN=replace-with-at-least-32-random-characters

POSTGRES_DB=dataset_gen
POSTGRES_USER=dataset_gen
POSTGRES_PASSWORD=replace-with-a-strong-database-password
FRONTEND_URL=http://localhost:4173
FRONTEND_PORT=4173
STORAGE_HOST_PATH=./data/storage
REFRESH_COOKIE_SECURE=false
REFRESH_ROTATION_GRACE_SECONDS=10
REGISTRATION_MODE=disabled

MAX_UPLOAD_BYTES=2147483648
MAX_IMPORTED_IMAGES=2000
TRAINING_JOB_LEASE_SECONDS=120
TRAINING_WORKER_OFFLINE_SECONDS=60
TASK_ITEM_LEASE_SECONDS=900
ASSET_GC_RETENTION_HOURS=24
IDEMPOTENCY_TTL_HOURS=24

VL_ANNOTATOR_PROVIDER=gemini
VL_ANNOTATOR_MODEL=gemini-2.0-flash
VL_ANNOTATOR_API_KEY=
VL_ANNOTATOR_BASE_URL=
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image-preview
GEMINI_PERSON_GENERATION=allow_adult
GEMINI_HTTP_PROXY=
JIMENG_BASE_URL=https://operator.las.cn-beijing.volces.com/api/v1
JIMENG_IMAGE_MODEL=doubao-seedream-3-0-t2i-250415
JIMENG_WATERMARK=true
OPENAI_COMPAT_API_KEY=
